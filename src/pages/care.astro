---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/site';
import { groupBy } from '../lib/content';
const sections = groupBy(await getCollection('faq'), (f) => f.data.section);
---
<BaseLayout title="Care guide and FAQ" description="How to apply, remove and care for your press-on nails, plus answers to common questions.">
  <div class="container narrow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span aria-hidden="true">›</span>Care</nav>
    <header class="page-head"><h1>Care guide and FAQ</h1><p>Everything you need to make your set last, and look good doing it.</p></header>
    {[...sections].map(([title, items]) => (
      <section class="faq">
        <h2>{title}</h2>
        {items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.data.question}</summary>
            <p>{f.data.answer}</p>
          </details>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .narrow { max-width: 820px; }
  .faq { margin-bottom: 2.5rem; }
  details { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 0.6rem; padding: 0 1.25rem; }
  summary { cursor: pointer; font-weight: 600; padding: 1rem 0; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--plum); font-size: 1.3rem; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { color: var(--muted); padding-bottom: 1rem; margin: 0; }
</style>
